# Kopieren nach apps/api/.env und anpassen. Echte Zugangsdaten NIE ins Repository.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# PostgreSQL (docker compose up -d db startet eine lokale Instanz mit diesen Werten)
DATABASE_URL=postgresql://udate:udate_dev@localhost:5432/udate
# Erlaubte Web-Herkunft für CORS (Komma-getrennt)
CORS_ORIGINS=http://localhost:3000
# Session-Geheimnis, mind. 32 Zeichen. Erzeugen: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=bitte-ersetzen-mindestens-32-zeichen-langes-geheimnis
# KI-Anbieter: "none" (Standard, KI-Funktionen melden "nicht verfügbar") oder später "anthropic"
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
