{
  "name": "udate",
  "version": "0.2.0",
  "private": true,
  "description": "UDate – Dating-Plattform mit persönlichem Attraktivitäts-Kompass",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter \"./packages/*\" build && pnpm -r test",
    "dev:api": "pnpm --filter @udate/api dev",
    "db:migrate": "pnpm --filter @udate/api db:migrate",
    "db:deploy": "pnpm --filter @udate/api db:deploy",
    "db:generate": "pnpm --filter @udate/api db:generate",
    "zip": "python3 tools/make_zip.py"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
