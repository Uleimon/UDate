{
  "name": "@udate/matching",
  "version": "0.1.0",
  "private": true,
  "description": "Matching-Engine von UDate: gegenseitige, erklärbare Kompatibilität. Reine Funktionen, keine Datenbank, keine KI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@udate/shared": "workspace:*" },
  "devDependencies": { "vitest": "^4.0.0", "typescript": "~5.9.3" }
}
